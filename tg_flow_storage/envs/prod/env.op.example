# Production example only. Replace the password before starting PostgreSQL.
# DB_NAME, DB_USER and DB_PASSWORD must match the bot and auth DB settings
# when all three use this same database. Keep existing credentials on upgrades.
DB_NAME=tg_flow
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Host port published by the current Compose file. It binds on all interfaces;
# use a private deployment configuration / firewall rather than exposing it.
DB_PORT=5432
NETWORK=flow_net
