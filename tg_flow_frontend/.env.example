# Development defaults work without a file. For a production Docker build,
# pass VITE_BOT_USERNAME as --build-arg; local .env files are excluded.
VITE_BOT_USERNAME=YOUR_BOT_USERNAME

# Optional: leave blank for same-origin production / local dev defaults.
# VITE_API_URL=https://flow.example.com
# VITE_AUTH_API_URL=https://flow.example.com/api/auth
