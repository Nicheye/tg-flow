#!/bin/sh
set -eu
umask 077
cd /opt/tg-flow
exec 9>/opt/tg-flow/.maintenance.lock
flock -n 9 || { echo 'Another maintenance operation is running.'; exit 1; }
target="/opt/tg-flow/backups/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -m 700 "$target"
docker compose exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$target/database.dump"
docker compose exec -T db sh -c 'pg_dumpall -U "$POSTGRES_USER" --globals-only' > "$target/globals.sql"
tar -czf "$target/deployment.tar.gz" .env telegram.env compose.yaml source-manifest.json src nginx bin letsencrypt OPERATIONS.md tg-flow-*.service tg-flow-*.timer
cd "$target"
sha256sum database.dump globals.sql deployment.tar.gz > SHA256SUMS
echo "Backup completed: $target"
