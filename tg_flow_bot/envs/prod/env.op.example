# Production example only. Replace every placeholder; never commit real secrets.
# Use the same public domain throughout this file for a same-origin deployment.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# Integrated auth and MCP (use canonical public URLs)
AUTH_LOCAL_ASGI=True
OAUTH_ISSUER=https://flow.example.com/
MCP_RESOURCE_URI=https://flow.example.com/mcp
MCP_INTROSPECTION_CLIENT_ID=tg-flow-mcp
MCP_INTROSPECTION_CLIENT_SECRET=CHANGE_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
MCP_ALLOWED_HOSTS=flow.example.com,flow.example.com:443
# If your client sends an Origin header, explicitly allow its trusted origin too.
MCP_ALLOWED_ORIGINS=https://flow.example.com

# FastAPI Settings
DEBUG=False
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=flow.example.com
CSRF_TRUSTED_ORIGINS=https://flow.example.com
CORS_ALLOWED_ORIGINS=https://flow.example.com
# Set to the actual reverse proxy's private IP or narrow CIDR, e.g. 172.30.0.2/32.
# Leave empty until the proxy address is known; no forwarding headers are trusted.
TRUSTED_PROXY_NETWORKS=

# Database Settings
DB_ENGINE=postgresql
# For a new shared database, match these to the storage env and AUTH_DB_* below.
DB_NAME=tg_flow
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_HOST=db
DB_PORT=5432

# Explicit Django PostgreSQL database. Reuse existing auth settings for upgrades.
AUTH_DB_ENGINE=postgresql
AUTH_DB_NAME=tg_flow
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
AUTH_DB_HOST=db
AUTH_DB_PORT=5432

# Network
NETWORK=flow_net
