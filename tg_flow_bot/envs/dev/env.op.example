# Bot Settings
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# Integrated auth and MCP
AUTH_LOCAL_ASGI=True
OAUTH_ISSUER=http://localhost:8081/
MCP_RESOURCE_URI=http://localhost:8081/mcp
MCP_INTROSPECTION_CLIENT_ID=tg-flow-mcp
MCP_INTROSPECTION_CLIENT_SECRET=development-only-introspection-secret
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# FastAPI Settings
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
DB_ENGINE=postgresql
DB_NAME=tg_flow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Explicitly identify the existing auth database, even when it shares the bot DB.
AUTH_DB_ENGINE=postgresql
AUTH_DB_NAME=tg_flow
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_HOST=db
AUTH_DB_PORT=5432
# For SQLite instead set AUTH_DB_ENGINE=sqlite3 and AUTH_DB_NAME=/path/to/auth.sqlite3.

# Network
NETWORK=flow_net
